generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  FLEET_MANAGER
  DISPATCHER
  SAFETY_OFFICER
  FINANCIAL_ANALYST
  DRIVER
}

enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  IN_SHOP
  RETIRED
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
  OFF_DUTY
  SUSPENDED
}

enum LicenseCategory {
  LMV
  HMV
  MCWG
}

enum DriverPayType {
  PER_TRIP
  HOURLY
}

enum TripStatus {
  DRAFT
  DISPATCHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DriverOnboardingStatus {
  PENDING
  NEEDS_REVIEW
  VERIFIED
  REJECTED
}

enum DriverDocumentType {
  PROFILE_PHOTO
  LICENSE_FRONT
  LICENSE_BACK
}

enum TripEvidenceType {
  ODOMETER_START
  ODOMETER_END
  SITE_UPDATE
  FUEL_RECEIPT
  EXPENSE_RECEIPT
  MAINTENANCE_REPORT
}

enum MaintenanceStatus {
  REPORTED
  ACTIVE
  CLOSED
}

enum ExpenseType {
  FOOD
  LODGING
  PARKING
  TOLL
  REPAIR
  INSURANCE
  DRIVER_PAYMENT
  OTHER
}

enum RecordSource {
  WEB
  DRIVER_MOBILE
  FASTAG
}

enum FastagConnectionStatus {
  PENDING
  ACTIVE
  ERROR
  DISCONNECTED
}

enum FastagTransactionStatus {
  PENDING
  SETTLED
  REVERSED
  DISPUTED
}

enum TollMatchStatus {
  MATCHED
  REVIEW_REQUIRED
  UNMATCHED
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  phone               String?
  jobTitle            String?
  avatarKey           String?
  passwordHash        String?
  googleSub           String?              @unique
  role                Role
  organizationId      String
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  isActive            Boolean              @default(true)
  mustChangePassword  Boolean              @default(false)
  sessionVersion      Int                  @default(0)
  lastLoginAt         DateTime?
  lastActiveAt        DateTime?
  createdAt           DateTime             @default(now())
  driver              Driver?
  copilotActions      CopilotAction[]
  passwordResetTokens PasswordResetToken[]

  @@index([organizationId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model Organization {
  id                 String              @id @default(cuid())
  name               String
  slug               String              @unique
  operationsEmail    String?
  createdAt          DateTime            @default(now())
  users              User[]
  vehicles           Vehicle[]
  drivers            Driver[]
  trips              Trip[]
  maintenance        Maintenance[]
  fuelLogs           FuelLog[]
  expenses           Expense[]
  driverDocuments    DriverDocument[]
  tripEvidence       TripEvidence[]
  tripLocations      TripLocation[]
  fastagConnections  FastagConnection[]
  fastagTransactions FastagTransaction[]
  copilotActions     CopilotAction[]
}

model Vehicle {
  id                      String              @id @default(cuid())
  registrationNo          String
  organizationId          String
  organization            Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                    String
  type                    String
  capacityKg              Float
  requiredLicenseCategory LicenseCategory     @default(LMV)
  odometerKm              Float               @default(0)
  acquisitionCost         Float
  status                  VehicleStatus       @default(AVAILABLE)
  region                  String              @default("Central")
  createdAt               DateTime            @default(now())
  trips                   Trip[]
  maintenance             Maintenance[]
  fuelLogs                FuelLog[]
  expenses                Expense[]
  tripEvidence            TripEvidence[]
  fastagConnection        FastagConnection?
  fastagTransactions      FastagTransaction[]

  @@unique([organizationId, registrationNo])
  @@index([organizationId])
}

model Driver {
  id               String                 @id @default(cuid())
  name             String
  licenseNo        String
  organizationId   String
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  licenseCategory  String
  licenseExpiry    DateTime
  contact          String
  payType          DriverPayType          @default(PER_TRIP)
  payRate          Float                  @default(0)
  safetyScore      Int                    @default(100)
  status           DriverStatus           @default(AVAILABLE)
  onboardingStatus DriverOnboardingStatus @default(PENDING)
  userId           String?                @unique
  user             User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  verifiedAt       DateTime?
  reviewedAt       DateTime?
  reviewedById     String?
  reviewNote       String?
  createdAt        DateTime               @default(now())
  trips            Trip[]
  documents        DriverDocument[]
  tripEvidence     TripEvidence[]
  tripLocations    TripLocation[]
  maintenance      Maintenance[]
  fuelLogs         FuelLog[]
  expenses         Expense[]

  @@unique([organizationId, licenseNo])
  @@index([organizationId])
}

model Trip {
  id                           String              @id @default(cuid())
  tripNo                       String
  organizationId               String
  organization                 Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source                       String
  destination                  String
  sourceCityId                 String?
  destinationCityId            String?
  sourceLatitude               Float?
  sourceLongitude              Float?
  destinationLatitude          Float?
  destinationLongitude         Float?
  cargoWeightKg                Float
  plannedDistanceKm            Float
  estimatedDurationMinutes     Int?
  estimatedToll                Float               @default(0)
  estimatedTollsInr            Float?
  estimatedDurationMin         Int?
  routeSummary                 String?
  tollEstimateStatus           String?
  routeEstimatedAt             DateTime?
  routeStrategy                String?
  routeLabel                   String?
  routeVia                     String?
  routeProvider                String?
  routePolyline                String?
  finalOdometerKm              Float?
  fuelConsumedL                Float?
  revenue                      Float               @default(0)
  estimatedFuelCostInr         Float?
  estimatedMaintenanceCostInr  Float?
  estimatedTripCostInr         Float?
  estimatedProfitInr           Float?
  estimatedProfitMarginPercent Float?
  profitabilityEstimatedAt     DateTime?
  actualFuelCostInr            Float?
  actualMaintenanceCostInr     Float?
  actualExpenseCostInr         Float?
  actualDriverPayoutInr        Float?
  actualTollCostInr            Float?
  actualTripCostInr            Float?
  actualProfitInr              Float?
  actualProfitMarginPercent    Float?
  profitabilityFinalizedAt     DateTime?
  status                       TripStatus          @default(DRAFT)
  vehicleId                    String
  driverId                     String
  vehicle                      Vehicle             @relation(fields: [vehicleId], references: [id])
  driver                       Driver              @relation(fields: [driverId], references: [id])
  createdAt                    DateTime            @default(now())
  dispatchedAt                 DateTime?
  startedAt                    DateTime?
  startOdometerKm              Float?
  completedAt                  DateTime?
  evidence                     TripEvidence[]
  locations                    TripLocation[]
  maintenance                  Maintenance[]
  fuelLogs                     FuelLog[]
  expenses                     Expense[]
  fastagTransactions           FastagTransaction[]
  copilotActions               CopilotAction[]

  @@unique([organizationId, tripNo])
  @@index([organizationId])
}

model DriverDocument {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  driverId       String
  driver         Driver             @relation(fields: [driverId], references: [id], onDelete: Cascade)
  type           DriverDocumentType
  objectKey      String             @unique
  mimeType       String
  originalName   String
  size           Int                @default(0)
  extractedData  Json?
  ocrConfidence  Float?
  createdAt      DateTime           @default(now())

  @@unique([driverId, type])
  @@index([organizationId, driverId])
}

model TripEvidence {
  id                  String           @id @default(cuid())
  organizationId      String
  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tripId              String
  trip                Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driverId            String
  driver              Driver           @relation(fields: [driverId], references: [id])
  vehicleId           String
  vehicle             Vehicle          @relation(fields: [vehicleId], references: [id])
  type                TripEvidenceType
  objectKey           String?          @unique
  mimeType            String?
  originalName        String?
  extractedOdometerKm Float?
  ocrConfidence       Float?
  registrationNo      String?
  note                String?
  latitude            Float?
  longitude           Float?
  fuelLiters          Float?
  amount              Float?
  fuelStation         String?
  clientRequestId     String?          @unique
  createdAt           DateTime         @default(now())

  @@index([organizationId, driverId])
  @@index([tripId, createdAt])
}

model TripLocation {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tripId          String
  trip            Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driverId        String
  driver          Driver       @relation(fields: [driverId], references: [id], onDelete: Cascade)
  clientRequestId String
  latitude        Float
  longitude       Float
  accuracyM       Float
  speedKph        Float?
  headingDeg      Float?
  altitudeM       Float?
  batteryPct      Int?
  isMocked        Boolean?
  capturedAt      DateTime
  receivedAt      DateTime     @default(now())

  @@unique([tripId, clientRequestId])
  @@index([organizationId, capturedAt])
  @@index([tripId, capturedAt])
  @@index([driverId, capturedAt])
}

model Maintenance {
  id                 String            @id @default(cuid())
  vehicleId          String
  organizationId     String
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle            Vehicle           @relation(fields: [vehicleId], references: [id])
  tripId             String?
  trip               Trip?             @relation(fields: [tripId], references: [id], onDelete: SetNull)
  driverId           String?
  driver             Driver?           @relation(fields: [driverId], references: [id], onDelete: SetNull)
  serviceType        String
  description        String?
  severity           String?
  reportedOdometerKm Float?
  cost               Float             @default(0)
  source             RecordSource      @default(WEB)
  objectKey          String?           @unique
  mimeType           String?
  originalName       String?
  clientRequestId    String?           @unique
  startDate          DateTime          @default(now())
  endDate            DateTime?
  status             MaintenanceStatus @default(ACTIVE)

  @@index([organizationId])
  @@index([tripId, driverId])
}

model FuelLog {
  id               String       @id @default(cuid())
  vehicleId        String
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle          Vehicle      @relation(fields: [vehicleId], references: [id])
  tripId           String?
  trip             Trip?        @relation(fields: [tripId], references: [id], onDelete: SetNull)
  driverId         String?
  driver           Driver?      @relation(fields: [driverId], references: [id], onDelete: SetNull)
  liters           Float
  cost             Float
  date             DateTime     @default(now())
  odometerKm       Float?
  fuelStation      String?
  source           RecordSource @default(WEB)
  receiptObjectKey String?      @unique
  receiptMimeType  String?
  receiptName      String?
  ocrConfidence    Float?
  extractedData    Json?
  clientRequestId  String?      @unique

  @@index([organizationId])
  @@index([tripId, driverId])
}

model Expense {
  id                String             @id @default(cuid())
  vehicleId         String
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle           Vehicle            @relation(fields: [vehicleId], references: [id])
  tripId            String?
  trip              Trip?              @relation(fields: [tripId], references: [id], onDelete: SetNull)
  driverId          String?
  submittedByDriver Driver?            @relation(fields: [driverId], references: [id], onDelete: SetNull)
  type              ExpenseType
  description       String?
  vendor            String?
  amount            Float
  date              DateTime           @default(now())
  source            RecordSource       @default(WEB)
  receiptObjectKey  String?            @unique
  receiptMimeType   String?
  receiptName       String?
  ocrConfidence     Float?
  extractedData     Json?
  clientRequestId   String?            @unique
  fastagTransaction FastagTransaction?

  @@index([organizationId])
  @@index([tripId, driverId])
}

model FastagConnection {
  id                 String                 @id @default(cuid())
  organizationId     String
  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicleId          String                 @unique
  vehicle            Vehicle                @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  provider           String
  issuerName         String
  maskedTagId        String?
  externalCustomerId String?
  status             FastagConnectionStatus @default(PENDING)
  lastSyncedAt       DateTime?
  lastError          String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  transactions       FastagTransaction[]

  @@index([organizationId, status])
}

model FastagTransaction {
  id              String                  @id @default(cuid())
  organizationId  String
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectionId    String
  connection      FastagConnection        @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  vehicleId       String
  vehicle         Vehicle                 @relation(fields: [vehicleId], references: [id])
  tripId          String?
  trip            Trip?                   @relation(fields: [tripId], references: [id], onDelete: SetNull)
  expenseId       String?                 @unique
  expense         Expense?                @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  providerTxnId   String
  maskedTagId     String?
  plazaName       String
  lane            String?
  occurredAt      DateTime
  amount          Float
  currency        String                  @default("INR")
  status          FastagTransactionStatus @default(PENDING)
  matchStatus     TollMatchStatus         @default(UNMATCHED)
  matchConfidence Float                   @default(0)
  rawPayload      Json?
  receivedAt      DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([connectionId, providerTxnId])
  @@index([organizationId, occurredAt])
  @@index([tripId, matchStatus])
}

model CopilotAction {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String
  status         String
  idempotencyKey String
  request        Json
  result         Json?
  tripId         String?
  trip           Trip?        @relation(fields: [tripId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([userId])
}
