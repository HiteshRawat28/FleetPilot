generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FLEET_MANAGER
  DISPATCHER
  SAFETY_OFFICER
  FINANCIAL_ANALYST
}

enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  IN_SHOP
  RETIRED
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
  OFF_DUTY
  SUSPENDED
}

enum TripStatus {
  DRAFT
  DISPATCHED
  COMPLETED
  CANCELLED
}

enum MaintenanceStatus {
  ACTIVE
  CLOSED
}

enum ExpenseType {
  TOLL
  REPAIR
  INSURANCE
  OTHER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
}

model Vehicle {
  id              String        @id @default(cuid())
  registrationNo  String        @unique
  name            String
  type            String
  capacityKg      Float
  odometerKm      Float         @default(0)
  acquisitionCost Float
  status          VehicleStatus @default(AVAILABLE)
  region          String        @default("Central")
  createdAt       DateTime      @default(now())
  trips           Trip[]
  maintenance     Maintenance[]
  fuelLogs        FuelLog[]
  expenses        Expense[]
}

model Driver {
  id              String       @id @default(cuid())
  name            String
  licenseNo       String       @unique
  licenseCategory String
  licenseExpiry   DateTime
  contact         String
  safetyScore     Int          @default(100)
  status          DriverStatus @default(AVAILABLE)
  createdAt       DateTime     @default(now())
  trips           Trip[]
}

model Trip {
  id                String     @id @default(cuid())
  tripNo            String     @unique
  source            String
  destination       String
  cargoWeightKg     Float
  plannedDistanceKm Float
  finalOdometerKm   Float?
  fuelConsumedL     Float?
  revenue           Float      @default(0)
  status            TripStatus @default(DRAFT)
  vehicleId         String
  driverId          String
  vehicle           Vehicle    @relation(fields: [vehicleId], references: [id])
  driver            Driver     @relation(fields: [driverId], references: [id])
  createdAt         DateTime   @default(now())
  dispatchedAt      DateTime?
  completedAt       DateTime?
}

model Maintenance {
  id          String            @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle           @relation(fields: [vehicleId], references: [id])
  serviceType String
  description String?
  cost        Float
  startDate   DateTime          @default(now())
  endDate     DateTime?
  status      MaintenanceStatus @default(ACTIVE)
}

model FuelLog {
  id         String   @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])
  liters     Float
  cost       Float
  date       DateTime @default(now())
  odometerKm Float?
}

model Expense {
  id          String      @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle     @relation(fields: [vehicleId], references: [id])
  type        ExpenseType
  description String?
  amount      Float
  date        DateTime    @default(now())
}
