DATABASE_URL="postgresql://transitops:transitops@localhost:5432/transitops?schema=public"
JWT_SECRET=hsjkfjsajkfsajkfsakjf
COPILOT_ACTION_SECRET=replace-with-a-long-random-secret
PORT=4000
FRONTEND_URL="http://localhost:5173,http://127.0.0.1:5173"
GOOGLE_CLIENT_ID=placeidhere 
# Password recovery uses console delivery outside production. Production requires
# EMAIL_PROVIDER=resend, a verified sender, and a server-side Resend API key.
PASSWORD_RESET_URL="http://localhost:5173/reset-password"
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
EMAIL_PROVIDER=console
EMAIL_FROM="FleetPilot <security@example.com>"
RESEND_API_KEY=<set-in-production>
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
# Fallback-only fuel rates. Recent recorded fuel price and completed-trip efficiency take priority.
TRIP_FUEL_RATE_DEFAULT_INR_PER_KM=18
TRIP_FUEL_RATE_VAN_INR_PER_KM=14
TRIP_FUEL_RATE_TRUCK_INR_PER_KM=24
TRIP_FUEL_RATE_BUS_INR_PER_KM=21
TRIP_MAINTENANCE_MIN_HISTORY_KM=1000
TRIP_VEHICLE_USEFUL_LIFE_KM=300000
# Optional Google Routes toll pass, for example IN_FASTAG. Omit for provider cash pricing.
ROUTE_TOLL_PASS=IN_FASTAG
R2_ACCOUNT_ID=<set>
R2_ACCESS_KEY_ID=<set>
R2_SECRET_ACCESS_KEY=<set>
R2_BUCKET_NAME=<set>
# Optional; defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=<set>
# Authorized FASTag issuer/fleet-provider integration. Vehicle number alone does
# not grant transaction access; use a provider token and signed webhooks.
FASTAG_PROVIDER_BASE_URL=<set>
FASTAG_PROVIDER_API_TOKEN=<set>
FASTAG_WEBHOOK_SECRET=<set-a-long-random-secret>
